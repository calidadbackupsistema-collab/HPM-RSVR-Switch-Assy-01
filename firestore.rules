rules_version = '2';
// Reglas de Firestore · Monitoreo RSVR Switch Ass'y (HPM-RSVR-Switch-Assy-01)
// Solo sesiones autenticadas (inicio de sesión anónimo desde el monitor) pueden leer y escribir.
// Nadie puede borrar alarmas ni causas desde el monitor: la evidencia queda íntegra.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvr_config/{docId} {
      allow read, write: if request.auth != null;
    }
    match /rsvr_causas/{docId} {
      allow read, create, update: if request.auth != null
        && request.resource.data.causa is string
        && request.resource.data.causa.size() > 0
        && request.resource.data.causa.size() < 2000;
      allow delete: if false;
    }
    match /rsvr_alarmas/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
